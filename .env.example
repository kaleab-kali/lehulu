# Copy to .env and change what you need:  cp .env.example .env
PORT=8080

# Demo sign-ins (<id> / <id>-demo for seeded partners and employers), sign-in codes shown on screen,
# and the SMS simulator page at /dev/sms. docker-compose.yml turns this on; set false in production.
DEMO_MODE=true

# Sites allowed to call the API from the browser, comma-separated, e.g.
#   ALLOWED_ORIGINS=https://savanna.alxafrica.com,https://lms.example.org
# Empty = only pages served by this server. "*" = any site (not recommended).
ALLOWED_ORIGINS=

# Public address of this server, used in SMS links ("continue later", partner registration).
PUBLIC_URL=http://localhost:8080

# 64 hex characters used to encrypt ID numbers at rest. Generate one with:  openssl rand -hex 32
# If empty, a key is created once and kept in KEY_FILE (inside the data volume). Back it up with the database.
DATA_KEY=
KEY_FILE=data/lehulu.key

# SMS: "simulator" shows messages at /dev/sms (DEMO_MODE only). A real gateway adapter plugs in at
# server/src/adapters/sms.rs. Without one, learners cannot receive sign-in codes in production.
SMS_ADAPTER=simulator

# Optional self-hosted speech-to-text (not built yet). Voice recordings are always kept as answers.
STT_ENABLED=false

# Delete accounts nobody has used for this many days, with their recordings and applications.
RETENTION_DAYS=365
