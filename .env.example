# Copy to .env (optional; these are the defaults):  cp .env.example .env
PORT=8080
# SMS: "simulator" shows messages at /dev/sms. A real gateway adapter can be added later.
SMS_ADAPTER=simulator
# Optional self-hosted speech-to-text (not built yet). Voice recordings are always kept as answers.
STT_ENABLED=false
# Delete inactive accounts after this many days (privacy policy; enforced by feature F21).
RETENTION_DAYS=365
